<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <LinearLayout
        android:id="@+id/bottomBarSearch"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/bottom_bar_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="70dp"
        android:elevation="12dp"
        android:translationZ="8dp"
        android:outlineProvider="background"

        >

    <ImageView
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/ic_search_white"
        android:alpha="0.6"

        />



    <EditText
        android:fontFamily="@font/exo2_variablefont_wght"
        android:id="@+id/editTextCity"
        android:layout_width="150dp"
        android:textColor="@color/white"
        android:layout_height="wrap_content"
        android:textColorHint="@color/white"
        android:hint="Поиск города"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textSize="20dp"
        android:gravity="center_vertical"
        android:background="@null"
        android:alpha="0.6"
        android:layout_marginStart="4dp"
        android:completionThreshold="1"

        />

        </LinearLayout>


    <Button
        android:fontFamily="@font/exo2_variablefont_wght"
        android:id="@+id/buttonSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Найти"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.19"
        android:backgroundTint="@color/black"
        android:textColor="@color/white"
        >

    </Button>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/PlateSearch1"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@drawable/main_plate_bg"
        android:padding="12dp"
        android:elevation="7dp"
        android:outlineProvider="background"
        app:layout_constraintTop_toBottomOf="@id/buttonSelect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="16dp"
        >


        <ImageView
            android:id="@+id/photoSearch1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/main_plate_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            >

        </ImageView>

        <TextView
            android:id="@+id/citySearch1"
            android:fontFamily="@font/exo2_variablefont_wght"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />


        <TextView
            android:id="@+id/timeSearch1"
            android:fontFamily="@font/exo2_variablefont_wght"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textStyle=""
            android:textSize="18dp"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/citySearch1"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/conditionSearch1"
            android:fontFamily="@font/exo2_variablefont_wght"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/black"
            android:textStyle=""
            android:textSize="18dp"
            app:layout_constraintTop_toBottomOf="@id/timeSearch1"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="1dp" />

        <TextView
            android:id="@+id/mainTemperatureSearch1"
            android:fontFamily="@font/exo2_variablefont_wght"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textStyle=""
            android:textSize="30dp"
            android:textColor="@color/black"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="25dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />






    </androidx.constraintlayout.widget.ConstraintLayout>


