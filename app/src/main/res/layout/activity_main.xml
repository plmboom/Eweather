<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.MainActivity"
    >
    <!--android:background="@color/white"-->


    <TextView
        android:id="@+id/city"
        android:fontFamily="@font/exo2_variablefont_wght"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text=""
        android:textStyle="bold"
        android:textSize="20dp"
        app:layout_constraintVertical_bias="0.06"

        />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainPlate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/main_plate_bg"
        android:padding="20dp"
        android:elevation="7dp"
        android:outlineProvider="background"
        app:layout_constraintTop_toBottomOf="@id/city"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="16dp"
        >

        <TextView
            android:id="@+id/mainTemperature"
            android:fontFamily="@font/exo2_variablefont_wght"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textStyle="bold"
            android:textSize="80dp"
            android:textColor="@color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/condition"
            android:fontFamily="@font/exo2_variablefont_wght"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="20dp"
            app:layout_constraintTop_toBottomOf="@id/mainTemperature"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"
            />


        <TextView
            android:id="@+id/todayDate"
            android:fontFamily="@font/exo2_variablefont_wght"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textStyle="bold"
            android:textSize="20dp"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/condition"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/leftPlate"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="@drawable/left_plate_bg"
        android:padding="20dp"
        android:elevation="7dp"
        android:outlineProvider="background"
        app:layout_constraintTop_toBottomOf="@id/mainPlate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightPlate"
        android:layout_marginStart="15dp"
        android:layout_marginTop="20dp"
        >

        <TextView
            android:fontFamily="@font/exo2_variablefont_wght"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ощущается как"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />



        <TextView
            android:id="@+id/feelsLikeTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:fontFamily="@font/exo2_variablefont_wght"
            android:text=""
            android:textColor="@color/black"
            android:textSize="50dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <!-- app:layout_constraintVertical_bias="0.27"-->


    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rightPlate"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="@drawable/main_plate_bg"
        android:padding="20dp"
        android:elevation="7dp"
        android:outlineProvider="background"
        app:layout_constraintTop_toBottomOf="@id/mainPlate"
        app:layout_constraintStart_toEndOf="@id/leftPlate"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="20dp"
        >




        <TextView
            android:fontFamily="@font/exo2_variablefont_wght"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Уф-индекс"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/uv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:fontFamily="@font/exo2_variablefont_wght"
            android:text=""
            android:textColor="@color/black"
            android:textSize="50dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />



    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/secondBigPlate"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="@drawable/main_plate_bg"
        android:padding="20dp"
        android:elevation="7dp"
        android:outlineProvider="background"
        app:layout_constraintTop_toBottomOf="@id/rightPlate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="16dp"
        >

        <TextView
            android:fontFamily="@font/exo2_variablefont_wght"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ветер"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/wind_kph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/exo2_variablefont_wght"
            android:text=""
            android:textColor="@color/black"
            android:textSize="20dp"
            android:textStyle=""
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/wind_dir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:fontFamily="@font/exo2_variablefont_wght"
            android:text=""
            android:textColor="@color/black"
            android:textSize="20dp"
            android:textStyle=""
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />


        <TextView
            android:id="@+id/gradus"
            android:fontFamily="@font/exo2_variablefont_wght"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="20dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <ImageView
            android:id="@+id/windArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/keyboard_double_arrow_up"
            android:layout_marginEnd="35dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="45dp"
            app:layout_constraintEnd_toEndOf="parent"
            />




    </androidx.constraintlayout.widget.ConstraintLayout>



    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/bottom_bar_bg"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"
        android:layout_marginBottom="24dp"
        android:elevation="12dp"
        android:translationZ="8dp"
        android:outlineProvider="background"

        >

        <Button
            android:id="@+id/buttonLeft"
            android:backgroundTint="@color/white"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:textSize="10dp"
            android:drawableTop="@drawable/ic_weather"
            android:drawablePadding="40dp"
            android:layout_margin="4dp"
            />



        <Button
            android:id="@+id/buttonCenter"
            android:backgroundTint="@color/white"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:textSize="10dp"
            android:drawableTop="@drawable/ic_search"
            android:drawablePadding="40dp"
            android:layout_margin="4dp"
            />

        <Button
            android:id="@+id/buttonRight"
            android:backgroundTint="@color/white"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:textSize="10dp"
            android:drawableTop="@drawable/ic_settings"
            android:drawablePadding="40dp"
            android:layout_margin="4dp"
            />

    </LinearLayout>



   


</androidx.constraintlayout.widget.ConstraintLayout>